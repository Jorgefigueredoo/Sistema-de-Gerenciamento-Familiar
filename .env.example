# =====================================================================
# Supabase — Dashboard > Project Settings > API Keys
#
# O Supabase renomeou as chaves. Vale qualquer uma das duas gerações:
#   anon public  = publishable key (sb_publishable_...)
#   service_role = secret key      (sb_secret_...)
# Preencha o par que o seu painel mostrar e deixe o outro em branco.
# =====================================================================

# URL do projeto (ex.: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública — pode ir para o navegador, o RLS é quem protege os dados.
# Preencha UMA das duas:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta — ignora o RLS. Só é usada no servidor, para o admin
# cadastrar pessoas. NUNCA prefixe com NEXT_PUBLIC_ nem commite.
# Preencha UMA das duas:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# URL base do app, usada nos links de "esqueci minha senha"
# Local: http://localhost:3000 | Produção: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
