# =====================================================================
# Supabase — Dashboard > Project Settings > API Keys
#
# O Supabase renomeou as chaves. Vale qualquer uma das duas gerações:
#   anon public  = publishable key (sb_publishable_...)
#   service_role = secret key      (sb_secret_...)
# Preencha o par que o seu painel mostrar e deixe o outro em branco.
# =====================================================================

# URL do projeto (ex.: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública — pode ir para o navegador, o RLS é quem protege os dados.
# Preencha UMA das duas:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta — ignora o RLS. Só é usada no servidor, para o admin
# cadastrar pessoas. NUNCA prefixe com NEXT_PUBLIC_ nem commite.
# Preencha UMA das duas:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# =====================================================================
# Notificações push — gere o par com `npx web-push generate-vapid-keys`
# =====================================================================

# Chave pública — vai para o navegador (não é segredo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Chave privada — só servidor. NUNCA commite.
VAPID_PRIVATE_KEY=

# Identifica quem manda as notificações, exigido pelo padrão Web Push.
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# String aleatória (16+ caracteres) que só a Vercel e esta rota conhecem.
# Protege o endpoint /api/cron/lembretes contra chamadas de fora.
CRON_SECRET=
